# Copy to .env.local and fill in. Never commit real keys in .env.example.
# Resend: https://resend.com/api-keys
RESEND_API_KEY=

# Plain email is safest on Vercel (no spaces). Or: GFA Forms <onboarding@resend.dev>
# Testing: onboarding@resend.dev | Production: noreply@your-verified-domain.com
RESEND_FROM=onboarding@resend.dev

# Inbox that receives each submitted authority PDF
TAX_AUTHORITY_EMAIL=gfa@glozonfintax.com
