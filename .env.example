# Microsoft 365 OneDrive — Power Automate only
# Copy this file to .env.local and fill POWER_AUTOMATE_WEBHOOK_URL.

# Full HTTP POST URL from Power Automate trigger "When an HTTP request is received"
POWER_AUTOMATE_WEBHOOK_URL=

# Folder name inside OneDrive (your flow should use this from the JSON body: "folder")
POWER_AUTOMATE_ONEDRIVE_FOLDER=ClientOnboarding
