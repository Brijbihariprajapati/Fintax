# Copy to .env.local and fill in. Never commit real keys in .env.example.
# Resend: https://resend.com/api-keys
RESEND_API_KEY=

# Format: Display Name <email@domain.com>
# Testing: onboarding@resend.dev | Production: address on a domain you verified in Resend
RESEND_FROM=GFA Forms <onboarding@resend.dev>

# Inbox that receives each submitted authority PDF
TAX_AUTHORITY_EMAIL=gfa@glozonfintax.com
